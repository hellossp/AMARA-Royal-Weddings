# ==============================================================================
# AMARA STUDIOS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Supabase (PostgreSQL Database & Auth)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Cloudinary (Cloud Media Storage & Delivery)
# Get these from your Cloudinary Console Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=amara_portfolio

# 3. Resend (Email Notifications for Inquiries)
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_1234567890abcdef
NOTIFICATION_RECIPIENT_EMAIL=concierge@amarastudios.in

# 4. Admin Credentials (Fallback for immediate local development without auth setup)
ADMIN_DEFAULT_EMAIL=admin@amarastudios.in
ADMIN_DEFAULT_PASSWORD=amara-luxury-2026

# 5. Site Base URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
